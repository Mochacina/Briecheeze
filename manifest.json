{
  "manifest_version": 3,
  "name": "Briecheeze - 네이버 스트리밍 유틸리티 프로그램",
  "version": "1.3.0",
  "description": "파지직의 불필요 트래픽을 차단하고, 자동 화질 설정 등 다양한 편의 기능을 제공합니다.",
  "permissions": [
    "storage",
    "debugger",
    "tabs"
  ],
  "host_permissions": [
    "*://chzzk.naver.com/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_popup": "popup.html",
    "default_icon": {
      "16": "images/icon16.png",
      "48": "images/icon48.png",
      "128": "images/icon128.png"
    }
  },
  "icons": {
    "16": "images/icon16.png",
    "48": "images/icon48.png",
    "128": "images/icon128.png"
  },
  "content_scripts": [
    {
      "matches": ["*://chzzk.naver.com/*"],
      "js": ["content.js"],
      "run_at": "document_start"
    }
  ],
  "web_accessible_resources": [
    {
      "resources": [
        "page_script.js",
        "rules.json"
      ],
      "matches": ["*://chzzk.naver.com/*"]
    }
  ]
}